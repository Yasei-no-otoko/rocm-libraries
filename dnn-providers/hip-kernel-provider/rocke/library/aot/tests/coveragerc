# Coverage config for the rocKE client AOT Python suites.
#
# The --fail-under=90 gate (wired in aot/CMakeLists.txt) is scoped to the
# reliably-exercised producer surface: the rocke_client_aot package, the SDPA
# family handler, and the AOT build tool.
[run]
branch = True
relative_files = True

[report]
include =
    */rocke_client_aot/*.py
    */fmha_mfma_aot.py
    */rocke_aot_build.py
